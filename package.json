{
  "name": "focus-trail",
  "version": "0.2.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isadfrn/focus-trail.git"
  },
  "scripts": {
    "prepare": "husky",
    "dev:db": "node scripts/dev-up.mjs",
    "dev": "concurrently -k -n api,web -c blue,green \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:up": "npm run dev:db && npm run dev",
    "changelog": "changelogen --output CHANGELOG.md",
    "release": "changelogen --release && node scripts/sync-versions.mjs --amend && git push --follow-tags",
    "release:minor": "changelogen --release --minor && node scripts/sync-versions.mjs --amend && git push --follow-tags",
    "release:major": "changelogen --release --major && node scripts/sync-versions.mjs --amend && git push --follow-tags"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "changelogen": "^0.6.2",
    "concurrently": "^10.0.5",
    "husky": "^9.1.7"
  }
}
