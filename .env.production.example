# Arquivo .env a ser criado na VPS em ~/focus-trail/.env
POSTGRES_USER=focus
POSTGRES_PASSWORD=gere_uma_senha_forte_aqui_ex_openssl_rand_hex_24
POSTGRES_DB=focustrail

# Segredo JWT (minimo 32 caracteres, gere com: openssl rand -base64 48)
JWT_SECRET=gere_uma_chave_segura_aqui

# Configuracoes da aplicacao
CORS_ORIGIN=https://isabellanunes.dev
SESSION_MAX_AGE=604800
ENABLE_SWAGGER=false

# E-mail (Resend) - opcional. Com as duas preenchidas, o app passa a exigir
# confirmacao de cadastro e habilita a recuperacao de senha por e-mail.
# O dominio de EMAIL_FROM precisa estar VERIFICADO no Resend.
RESEND_API_KEY=
EMAIL_FROM=Focus Trail <no-reply@isabellanunes.dev>
