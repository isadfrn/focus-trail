meta {
  name: Change Password
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/api/me/password
  body: json
  auth: none
}

body:json {
  {
    "currentPassword": "{{password}}",
    "newPassword": "ChangeMe123456"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3001
  corsOrigin: http://localhost:5173
}
