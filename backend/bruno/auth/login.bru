meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Origin: {{corsOrigin}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3001
  email: isadfrn@gmail.com
  password: Senha1234567890
  corsOrigin: http://localhost:5173
}
