meta {
  name: Reset Password
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "code": "123456",
    "newPassword": "ChangeMe123456"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3001
  corsOrigin: http://localhost:5173
}
