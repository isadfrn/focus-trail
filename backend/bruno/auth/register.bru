meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Origin: {{corsOrigin}}
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

vars:pre-request {
  baseUrl: http://localhost:3001
  email: isa@gmail.com
  password: Senha@1234567890
  corsOrigin: http://localhost:5173
}
