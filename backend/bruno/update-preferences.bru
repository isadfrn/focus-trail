meta {
  name: Update Preferences
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/me
  body: json
  auth: none
}

body:json {
  {
    "character": "mario-world",
    "focusMinutes": 25,
    "breakMinutes": 5,
    "autoCycle": true,
    "longBreakMinutes": 15,
    "pomodorosUntilLongBreak": 4,
    "dailyFocusGoalMinutes": 120
  }
}

vars:pre-request {
  baseUrl: http://localhost:3001
