meta {
  name: Create Session
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sessions
  body: json
  auth: none
}

body:json {
  {
    "startedAt": "2026-09-10T20:00:00.000Z",
    "endedAt": "2026-09-10T20:25:00.000Z",
    "durationSeconds": 1500,
    "type": "focus",
    "completed": true
  }
}

vars:pre-request {
  baseUrl: http://localhost:3001
  corsOrigin: http://localhost:5173
}
